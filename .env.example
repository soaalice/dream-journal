# Copy to .env and fill in. NEVER commit .env.
PORT=5000
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/dream-journal

# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Exact origin of the frontend (used for CORS + CSRF origin check)
CLIENT_ORIGIN=http://localhost:5173

# Set to true when running behind a reverse proxy (so rate limiting sees real IPs)
TRUST_PROXY=false

# Comma-separated hosts allowed for avatar URLs
AVATAR_HOSTS=api.dicebear.com

# Content is hidden automatically once this many different people reported it, until a moderator decides.
# 0 turns auto-hiding off.
AUTO_HIDE_REPORT_THRESHOLD=10

# Serve the built frontend (dist/) from this server, with strict security headers (CSP and friends).
# Build the client with VITE_API_URL=/api first. Optional CLIENT_DIR changes where dist/ is.
SERVE_CLIENT=false
# CLIENT_DIR=
# Only needed when the API is on a different domain than the frontend (adds it to the CSP connect-src)
# API_ORIGIN=
